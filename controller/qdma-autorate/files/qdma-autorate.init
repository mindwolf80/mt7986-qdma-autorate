#!/bin/sh /etc/rc.common
# qdma-autorate: QDMA hardware download shaper (qdma_rl, scheduler mode) driven by ePPing delay.
# Switch back to plain SQM/CAKE:  service qdma-autorate stop && service qdma-autorate disable
# Switch on again:                service qdma-autorate enable && service qdma-autorate start

START=99
STOP=10
USE_PROCD=1

PROG=/usr/sbin/qdma-autorate
BPF=/usr/lib/qdma-autorate/pping_kern.o
LOCK=/var/lock/qdma-autorate.lock
PARAM=/sys/module/qdma_rl/parameters
# match the controller by command line: pidof would also match this script (same process name)
CTL_PATTERN='^/usr/sbin/qdma-autorate '

log() { logger -t qdma-autorate -p "daemon.$1" "$2"; }

load_cfg() {
	config_load qdma-autorate
	config_get_bool ENABLED main enabled 1
	config_get WAN main wan wan
	config_get LAN main lan_dev eth0
	config_get QUEUES main queues 3,4,5,6,8
	config_get WD main watchdog_ms 2000
	config_get ARGS main args ""
}

wan_status() { ubus call network.interface."$WAN" status 2>/dev/null | jsonfilter -e "$1"; }

# sqm section shaping the WAN device
sqm_section_for() {
	uci -q show sqm | sed -n "s/^sqm\.\([^.]*\)\.interface='$1'$/\1/p" | head -n 1
}

# eth0 root -> mq 1: with unlimited CAKE on each LAN queue (queue q = netdev tx-q = mq class 1:(q+1))
lan_qdiscs() {
	local q
	tc qdisc replace dev "$LAN" root handle 1: mq || return 1
	for q in $(echo "$QUEUES" | tr ',' ' '); do
		tc qdisc replace dev "$LAN" parent "1:$(printf %x $((q + 1)))" cake unlimited besteffort dual-dsthost || return 1
	done
}

start_service() {
	local i dev sec cur
	load_cfg
	[ "$ENABLED" = 1 ] || return 0
	exec 9>"$LOCK"
	flock 9

	i=0
	while [ "$(wan_status @.up)" != true ] && [ $i -lt 60 ]; do
		sleep 1
		i=$((i + 1))
	done
	dev=$(wan_status @.l3_device)
	if [ "$(wan_status @.up)" != true ] || [ -z "$dev" ]; then
		log err "$WAN not up after 60 s, not starting"
		return 1
	fi

	sec=$(sqm_section_for "$dev")
	if [ -n "$sec" ]; then
		if [ -z "$(uci -q get qdma-autorate.main.sqm_download_orig)" ]; then
			cur=$(uci -q get "sqm.$sec.download")
			uci set qdma-autorate.main.sqm_download_orig="${cur:-0}"
			uci set qdma-autorate.main.sqm_section="$sec"
			uci commit qdma-autorate
		fi
		if [ "$(uci -q get "sqm.$sec.download")" != 0 ]; then
			uci set "sqm.$sec.download=0"
			uci commit sqm
			/etc/init.d/sqm restart
		fi
	fi

	[ -d "$PARAM" ] || insmod qdma_rl mode=scheduler queues="$QUEUES" watchdog_ms="$WD" || {
		log err "insmod qdma_rl failed"
		return 1
	}
	lan_qdiscs || {
		log err "LAN qdisc setup on $LAN failed"
		return 1
	}

	procd_open_instance
	# shellcheck disable=SC2086
	procd_set_param command "$PROG" -i "$dev" -o "$BPF" --lan-dev "$LAN" $ARGS
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}

# Runs after procd has stopped the controller (which writes rate_mbps=0 on SIGTERM).
service_stopped() {
	local i sec orig
	load_cfg
	exec 9>"$LOCK"
	flock 9

	i=0
	while pgrep -f "$CTL_PATTERN" >/dev/null && [ $i -lt 5 ]; do
		sleep 1
		i=$((i + 1))
	done
	# shellcheck disable=SC2046 # one or more PIDs; busybox here has no pkill
	pgrep -f "$CTL_PATTERN" >/dev/null && kill -9 $(pgrep -f "$CTL_PATTERN") 2>/dev/null
	if [ -d "$PARAM" ]; then
		echo 0 >"$PARAM/rate_mbps" 2>/dev/null
		rmmod qdma_rl || log err "rmmod qdma_rl failed"
	fi
	tc qdisc del dev "$LAN" root 2>/dev/null

	# restart and shutdown/reboot keep SQM's download at 0; only a stop puts the original rate back
	# shellcheck disable=SC2154 # $action is set by /etc/rc.common
	case "$action" in restart | shutdown) return 0 ;; esac
	sec=$(uci -q get qdma-autorate.main.sqm_section)
	orig=$(uci -q get qdma-autorate.main.sqm_download_orig)
	if [ -n "$sec" ] && [ -n "$orig" ]; then
		uci set "sqm.$sec.download=$orig"
		uci commit sqm
		uci set qdma-autorate.main.sqm_download_orig=''
		uci set qdma-autorate.main.sqm_section=''
		uci commit qdma-autorate
		/etc/init.d/sqm restart
	fi
}
